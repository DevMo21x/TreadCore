{
  "name": "nextjs-starter-template",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "preinstall": "node -e \"if(!process.env.npm_execpath?.includes('pnpm')){console.error('\\n  ✖ This project requires pnpm — npm is not supported.\\n\\n  Run the following instead:\\n    rm -rf node_modules\\n    pnpm install\\n\\n  If you don\\'t have pnpm: npm i -g pnpm\\n');process.exit(1)}\"",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "next typegen && tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:restore": "tsx scripts/restore.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "bad-words": "^4.0.0",
    "better-sqlite3": "^12.9.0",
    "drizzle-orm": "^0.45.2",
    "mqtt": "^5.15.1",
    "next": "16.1.6",
    "next-auth": "^5.0.0-beta.31",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "react": "19.2.3",
    "react-activity-calendar": "^3.2.0",
    "react-dom": "19.2.3",
    "recharts": "^3.8.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@commitlint/cli": "^20",
    "@commitlint/config-conventional": "^20",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "@vitest/coverage-v8": "^4",
    "@vitest/ui": "^4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "eslint-plugin-jsx-a11y": "^6",
    "husky": "^9",
    "jsdom": "^28",
    "lint-staged": "^16",
    "prettier": "^3",
    "tailwindcss": "^4",
    "typedoc": "^0.28.19",
    "typescript": "^5",
    "vitest": "^4"
  }
}
