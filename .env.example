# Application

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Treadmill

# Support email shown on the home screen for users who forgot their PIN.
# The treadmill is offline, so users read this address on-screen and email the admin from their phone.
# This is a server-only variable — changing it does NOT require a rebuild.
ADMIN_EMAIL=

# Auth Secret

AUTH_SECRET=

# MQTT Broker

MQTT_BROKER_URL=mqtt://192.168.5.1:1883
MQTT_CLIENT_ID=treadmill-nextjs

# Set to true to use simulated data instead of connecting to the real broker
MQTT_USE_MOCK=false

# Media storage (local filesystem path)
# Default when unset: <project root>/media
# Examples:
#   Linux/macOS: MEDIA_DIR=/var/treadmill/media
#   Local testing: MEDIA_DIR=/tmp/treadmill-media
MEDIA_DIR=

# Database

# The path to the SQLite database file. Defaults to "sqlite.db" in the project root.
# Example: DATABASE_PATH=./data/app.db
DATABASE_PATH=

# Automated Backup (USB device/drive)

# The path to the mounted USB device/drive backup folder.
# Examples:
#   Linux: BACKUP_DESTINATION_PATH=/media/usb/backups
#   Windows: BACKUP_DESTINATION_PATH=E:\backups
BACKUP_DESTINATION_PATH=

# Cron expression defining how often backups are performed.
# Default example runs at 2am daily: 0 2 * * *
BACKUP_CRON_SCHEDULE=0 2 * * *

# Number of days to retain backup files before automatic deletion.
# Example: Keep 30 days of backups
BACKUP_RETENTION_DAYS=30

# Optional: directory where the application writes failure log files directly.
# When set, the app creates .log files in this directory for each failure event.
# Example: Linux: BACKUP_LOGS_PATH=/var/log/smart-treadmill/backups  Windows: BACKUP_LOGS_PATH=C:\logs\backups
BACKUP_LOGS_PATH=
